# JustHireMe environment variables
#
# Copy to .env only if you need shell-level overrides. Most users should enter
# API keys in the desktop app settings instead — settings always take precedence
# over the environment.
#
# Every JHM_* variable the app understands is listed here. The list is kept
# honest by backend/tests/unit/common/test_env_registry.py, which fails if
# core/env.py declares a JHM_* variable this file does not document.

# ── Paths / runtime layout ────────────────────────────────────────────────────
# Where the app stores crm.db, the graph, vectors and generated PDFs.
JHM_APP_DATA_DIR=
# Parent directory to derive the app-data dir from, instead of the OS default.
JHM_APP_DATA_BASE_DIR=
# Reported by /health and used to name the runtime pack.
JHM_APP_VERSION=
# DEBUG | INFO | WARNING | ERROR   (default INFO)
JHM_LOG_LEVEL=INFO

# ── Feature switches ──────────────────────────────────────────────────────────
# Experimental automation lab only: allow unattended form submission.
JHM_AUTO_APPLY=false
# Set to "cgfe" to use the coverage-grounded fit engine.
JHM_FIT_ENGINE=
# Set falsey (0/false/no/off) to disable LLM use during portfolio extraction.
JHM_PORTFOLIO_LLM=
# Write error telemetry to a local JSONL file (never leaves the device).
JHM_LOCAL_ERROR_TELEMETRY=
# Override the path of that file.
JHM_ERRORS_JSONL=
# Reasoning effort for the Codex subscription CLI (default "low").
JHM_CODEX_REASONING=

# ── Optional runtime pack (LanceDB / ONNX / Chromium) ─────────────────────────
JHM_RUNTIME_PACK_URL=
JHM_BUNDLED_RUNTIME_PACK_URL=
JHM_RELEASE_RUNTIME_PACK_URL=
JHM_RUNTIME_PACK_VERSION=
JHM_VECTOR_RUNTIME_DIR=
JHM_VECTOR_RUNTIME_URL=
JHM_BROWSER_RUNTIME_DIR=
JHM_BROWSER_RUNTIME_URL=
PLAYWRIGHT_BROWSERS_PATH=
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# ── Optional local model endpoint ─────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/v1

# ── Optional provider keys for local backend experiments ──────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_COMPAT_BASE_URL=

# ── Optional enrichment / scouting credentials ────────────────────────────────
HUNTER_API_KEY=
PROXYCURL_API_KEY=
X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=
