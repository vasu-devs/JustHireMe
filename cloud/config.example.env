# Copy to config.env, which is ignored. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://REPLACE:REPLACE@REPLACE:5432/postgres?sslmode=require
SUPABASE_URL=https://REPLACE.supabase.co
SUPABASE_PUBLIC_KEY=REPLACE-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=REPLACE-server-only-key
# Empty provider values disable their endpoints and buying/drafting buttons.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
APPLE_ROOT_CERTIFICATES=
APPLE_BUNDLE_ID=com.justhireme.mobile
APPLE_APP_ID=
APPLE_ENVIRONMENT=Production
# Supabase user IDs for designated App Review / sandbox accounts only.
APPLE_SANDBOX_ACCOUNT_IDS=
APPLE_API_KEY_PATH=
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=
# Set only after deciding/publishing your applicable financial-record retention policy.
FINANCIAL_RETENTION_DAYS=
