# Adversarial regressions from the v1.6.1 false-positive incident. These are
# production guarantees: technology words cannot launder a different occupation,
# genuine same-field candidates still clear the title guard, and responsibility
# prose cannot fabricate a seniority requirement.
{"id": "adv-ai-copy-does-not-launder-abm", "field": "adversarial_fit", "profile": {"s": "AI engineer building production agent systems.", "skills": [{"n": "Python"}, {"n": "FastAPI"}, {"n": "LLM"}, {"n": "RAG"}, {"n": "TypeScript"}], "exp": [{"role": "AI Engineer", "co": "Startup", "period": "Jun 2026 - Present", "d": "Built Python LLM and RAG services"}], "projects": [{"title": "Voice Agent", "stack": ["Python", "LLM", "FastAPI"], "impact": "Shipped a production voice agent"}]}, "jd": "Job Title: Senior Account Based Marketing Manager\nCompany: Dropbox\nDescription: Own ABM campaigns, account personalization, digital advertising, sales outreach, pipeline creation, and marketing analytics. Requires 6+ years of B2B marketing experience. Use generative AI tools for campaign research and support GTM motions for AI products.", "expect": {"max": 15, "capped": true}, "invariant": true, "note": "The exact false-positive shape: AI body copy must not turn an ABM manager role into an AI-engineering fit"}
{"id": "adv-python-modifier-does-not-launder-marketing", "field": "adversarial_fit", "profile": {"s": "Backend engineer.", "skills": [{"n": "Python"}, {"n": "FastAPI"}, {"n": "PostgreSQL"}], "exp": [{"role": "Backend Engineer", "co": "Acme", "period": "2022 - Present", "d": "Python FastAPI services"}]}, "jd": "Job Title: Python Marketing Manager\nDescription: Own campaigns, positioning, copy, and demand generation. Use Python for campaign analytics.", "expect": {"max": 15, "capped": true}, "invariant": true, "note": "A tool modifier cannot override the explicit occupation in the title"}
{"id": "adv-ml-modifier-does-not-launder-content", "field": "adversarial_fit", "profile": {"s": "Machine learning engineer.", "skills": [{"n": "Python"}, {"n": "Machine Learning"}, {"n": "LLM"}], "projects": [{"title": "Classifier", "stack": ["Python", "Machine Learning"], "impact": "Deployed a classifier"}]}, "jd": "Job Title: Machine Learning Content Writer\nDescription: Write blogs, newsletters, and social copy about machine learning products.", "expect": {"max": 15, "capped": true}, "invariant": true, "note": "Topical ML knowledge does not make a writing position an ML-engineering position"}
{"id": "adv-real-marketer-clears-title-guard", "field": "adversarial_fit", "profile": {"s": "Growth marketer with 4 years in B2B demand generation.", "skills": [{"n": "Account Based Marketing"}, {"n": "Demand Generation"}, {"n": "Campaign Strategy"}, {"n": "Google Analytics"}], "exp": [{"role": "Growth Marketing Specialist", "co": "SaaSCo", "period": "Jan 2022 - Present", "d": "Owned account based marketing, demand generation, campaign strategy, and analytics"}]}, "jd": "Job Title: Account Based Marketing Manager\nDescription: Own account based marketing, demand generation, campaign strategy, and Google Analytics. 3+ years.", "expect": {"min": 58, "max": 86, "capped": false}, "invariant": true, "note": "The guard remains candidate-relative: multiple candidate-owned domain signals prove this is the marketer's field"}
{"id": "adv-one-buzzword-cannot-clear-title-guard", "field": "adversarial_fit", "profile": {"s": "AI engineer building production services.", "skills": [{"n": "Python"}, {"n": "FastAPI"}, {"n": "LLM"}, {"n": "GTM Strategy"}], "exp": [{"role": "AI Engineer", "co": "Startup", "period": "2023 - Present", "d": "Built production Python and LLM services"}]}, "jd": "Job Title: Generative AI Marketing Manager\nDescription: Own campaigns and GTM strategy using generative AI tools.", "expect": {"max": 15, "capped": true}, "invariant": true, "note": "One incidental candidate phrase is not substantive occupation evidence"}
{"id": "adv-hiring-manager-is-not-manager-seniority", "field": "adversarial_fit", "profile": {"s": "Software engineer with 18 months experience.", "skills": [{"n": "Python"}, {"n": "FastAPI"}], "exp": [{"role": "Software Engineer", "co": "Acme", "period": "Jan 2025 - Jun 2026", "d": "Built Python and FastAPI services"}], "projects": [{"title": "API", "stack": ["Python", "FastAPI"], "impact": "Shipped an API"}]}, "jd": "Job Title: Software Engineer\nDescription: Build Python and FastAPI services. The final interview is with the hiring manager.", "expect": {"min": 55, "capped": false}, "invariant": true, "note": "Hiring-process prose must not fabricate a manager-level experience requirement"}
{"id": "adv-lead-verb-is-not-lead-title", "field": "adversarial_fit", "profile": {"s": "Software engineer with 18 months experience.", "skills": [{"n": "Python"}, {"n": "FastAPI"}], "exp": [{"role": "Software Engineer", "co": "Acme", "period": "Jan 2025 - Jun 2026", "d": "Built Python and FastAPI services"}], "projects": [{"title": "API", "stack": ["Python", "FastAPI"], "impact": "Shipped an API"}]}, "jd": "Job Title: Software Engineer\nDescription: Build Python and FastAPI services and lead API design for a small feature.", "expect": {"min": 55, "capped": false}, "invariant": true, "note": "A responsibility verb must not be parsed as a Lead job title"}
